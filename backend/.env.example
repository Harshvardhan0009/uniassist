# UniAssist Backend — Environment Variables
# Copy this file to `.env` and fill in your API keys.

# ── API / Security ───────────────────────────────────────────────────
# Comma-separated CORS origins allowed to call the API.
# In production set this to your deployed frontend URL(s).
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Bearer token required to trigger POST /api/ingest.
# Leave empty to DISABLE ingestion over HTTP (the CLI pipeline still works).
INGEST_TOKEN=
# Per-IP requests/minute for /api/query (0 = disabled).
RATE_LIMIT_PER_MINUTE=0

# ── LLM (OpenRouter / xAI Grok / any OpenAI-compatible provider) ────
# Provider-neutral names. Legacy GROK_* names are still accepted.
# OpenRouter: https://openrouter.ai/  |  xAI: https://console.x.ai/
LLM_API_KEY=
LLM_BASE_URL=https://api.x.ai/v1
LLM_MODEL=grok-3-mini

# ── Fallback LLM (optional, OpenAI-compatible; e.g. Groq) ────────────
# Used automatically when the PRIMARY LLM errors, rate-limits, hits its quota,
# or returns an empty response. Leave the key empty to disable failover.
# Groq keys: https://console.groq.com/keys  (legacy alias: GROQ_API_KEY)
FALLBACK_LLM_API_KEY=
FALLBACK_LLM_BASE_URL=https://api.groq.com/openai/v1
FALLBACK_LLM_MODEL=openai/gpt-oss-120b

# ── Cohere ───────────────────────────────────────────────────────────
# Get your key at https://dashboard.cohere.com/api-keys
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-v3.5

# ── ChromaDB (Vector Store) ──────────────────────────────────────────
# Leave CHROMA_HOST empty for local persistent file mode (chroma_db/).
# For shared Client-Server mode (Render / Railway / EC2 / Cloud):
# set CHROMA_HOST to your server domain/IP (e.g. uniassist-chroma.onrender.com).
CHROMA_HOST=
CHROMA_PORT=8001
CHROMA_SSL=false
CHROMA_AUTH_TOKEN=
CHROMA_COLLECTION=university_docs

# ── Embedding ────────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
# Max concurrent LLM calls during ingestion summarization.
SUMMARY_CONCURRENCY=5
RETRIEVAL_TOP_K=20
RERANK_TOP_N=5
# Drop candidates below this cosine relevance score (0.0 = keep all).
RETRIEVAL_MIN_SCORE=0.0
