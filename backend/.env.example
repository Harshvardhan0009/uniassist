# UniAssist Backend — Environment Variables Template
# Copy this file to `.env` and fill in your API keys.

# ── API / Security ───────────────────────────────────────────────────
# Comma-separated CORS origins allowed to call the API.
# In production set this to your deployed frontend URL(s).
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Bearer token required to trigger POST /api/ingest over HTTP.
# Leave empty to DISABLE ingestion over HTTP (the CLI pipeline still works).
INGEST_TOKEN=
# Per-IP requests/minute for /api/query and /api/query/stream (0 = disabled).
RATE_LIMIT_PER_MINUTE=0

# ── Primary LLM (Phase 11 Winner: Gemini 3.6 Flash / OpenRouter / OpenAI-compatible) ──
# Google AI Studio: https://aistudio.google.com/  (OpenAI-compatible endpoint)
# OpenRouter: https://openrouter.ai/  |  Groq: https://console.groq.com/
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.6-flash

# ── Fallback LLM (Phase 11 Fallback Winner: Groq gpt-oss-120b) ─────────
# Used automatically when the PRIMARY LLM errors, rate-limits, hits quota,
# or returns an empty response. Leave empty to disable failover.
FALLBACK_LLM_API_KEY=
FALLBACK_LLM_BASE_URL=https://api.groq.com/openai/v1
FALLBACK_LLM_MODEL=openai/gpt-oss-120b

# ── Cohere Reranker (Phase 8 Winner: rerank-v3.5) ─────────────────────
# Get your key at https://dashboard.cohere.com/api-keys
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-v3.5

# ── ChromaDB (Vector Store) ──────────────────────────────────────────
# Leave CHROMA_HOST empty for local persistent file mode (chroma_db/).
# For shared Client-Server mode (Render / Railway / EC2 / Cloud):
# set CHROMA_HOST to your server host (e.g. uniassist-chroma.onrender.com).
CHROMA_HOST=uniassist-chroma.onrender.com
CHROMA_PORT=443
CHROMA_SSL=true
CHROMA_AUTH_TOKEN=
CHROMA_COLLECTION=university_docs

# ── Embedding Model (Phase 7 Winner: intfloat/e5-base-v2, 768-dim) ────
EMBEDDING_MODEL=intfloat/e5-base-v2

# ── Chunking (Phase 10 Winner: 1500 chars / 200 overlap) ─────────────
CHUNK_SIZE=1500
CHUNK_OVERLAP=200

# ── Ingestion Options ────────────────────────────────────────────────
# Raw text indexing preserves exact tabular and numerical precision (Phase 7 finding).
ENABLE_INGESTION_SUMMARIZATION=false
SUMMARY_CONCURRENCY=5

# ── Retrieval & Reranking ────────────────────────────────────────────
RETRIEVAL_TOP_K=20
RERANK_TOP_N=5
RETRIEVAL_MIN_SCORE=0.0

# ── Pipeline Enhancements ───────────────────────────────────────────
# Query Rewriter: Turn 2+ follow-up resolution (+50% conversational recall)
ENABLE_QUERY_REWRITING=true
# Context Compressor: Distractor chunk tail-pruning (-15.8% tokens, 100% recall)
ENABLE_CONTEXT_COMPRESSION=true
